[
  {
    "name": "check_packages",
    "title": "Check packages",
    "description": "Look up one or more packages and report the latest stable version, publish dates, whether the requested version is deprecated, its declared license, a verdict of no_known_issues, review, or avoid with reasons, and known advisory IDs from OSV.dev with the first fixed version. Known malware records are listed first. Facts come from deps.dev, the npm registry, PyPI, RubyGems, Packagist, and OSV.dev at the time shown. 'No known advisories' means none were found in OSV.dev. It is not a promise that no advisory exists. Versions published less than 72 hours ago are flagged. This tool does not install or change anything.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ecosystem": {
                "type": "string",
                "enum": [
                  "npm",
                  "pypi",
                  "go",
                  "maven",
                  "cargo",
                  "nuget",
                  "rubygems",
                  "composer"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 214
              },
              "version": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "ecosystem",
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        },
        "include_prerelease": {
          "type": "boolean"
        }
      },
      "required": [
        "packages"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "attribution": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "attribution"
            ],
            "additionalProperties": false
          }
        },
        "checked_at": {
          "type": "string"
        },
        "cache_age_seconds": {
          "type": "number"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "sources",
        "checked_at",
        "cache_age_seconds",
        "notes",
        "stale"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
