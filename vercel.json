{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 20,
      "includeFiles": "logo.jpg"
    },
    "api/cron/watch.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["logo.jpg"],
        "memory": 1024,
        "maxDuration": 20
      }
    },
    {
      "src": "api/cron/watch.ts",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/api/cron/watch", "dest": "api/cron/watch.ts" },
    { "src": "/(.*)", "dest": "api/index.ts" }
  ],
  "crons": [
    { "path": "/api/cron/watch", "schedule": "0 11 * * *" }
  ]
}
