{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && mkdir -p public && cp logo.jpg public/logo.jpg",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 20,
      "includeFiles": "logo.jpg"
    },
    "api/cron/watch.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/cron/watch", "destination": "/api/cron/watch" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/watch", "schedule": "0 * * * *" }
  ]
}
