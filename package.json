    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.36.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
